{
  "expo": {
    "name": "Opera",
    "slug": "opera",
    "version": "0.9.11",
    "orientation": "default",
    "icon": "./assets/icons/opera.png",
    "scheme": [
      "opera",
      "com.googleusercontent.apps.390321100520-3mi4mkdrdt8ke2nvl3ksbjef000ad5eg",
      "com.googleusercontent.apps.390321100520-8pkv241s2finuqth4cc9h74ii4ph99af"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icons/opera.png",
      "supportsTablet": true,
      "bundleIdentifier": "ai.maestro.opera"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF1A1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "ai.maestro.opera",
      "versionCode": 1,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "com.android.alarm.permission.SET_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon_nobg.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF1A1A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "dark",
          "backgroundColor": "transparent"
        }
      ],
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Opera needs access to your microphone for voice-to-text."
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Opera needs access to your photos to attach them.",
          "savePhotosPermission": "Opera needs access to save photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Opera needs access to your photos to attach them.",
          "cameraPermission": "Opera needs access to your camera to take photos."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Opera needs access to your contacts to look up phone numbers and emails when you ask."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Opera needs calendar access to check, create, and manage your events when you ask."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Opera uses your location to give the assistant local context for better answers.",
          "locationWhenInUsePermission": "Opera uses your location to give the assistant local context for better answers."
        }
      ],
      "./plugins/withNotifeeRepo.js",
      "./plugins/withNativeAndroid",
      "expo-speech-recognition",
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "new_chat": "./assets/icons/add.png"
          },
          "iosIcons": {
            "new_chat": "./assets/icons/add.png"
          },
          "iosActions": [
            {
              "id": "new-chat",
              "title": "New Chat",
              "subtitle": "Start a new conversation",
              "icon": "new_chat",
              "params": {
                "action": "new-chat"
              }
            }
          ]
        }
      ],
      "react-native-quick-crypto"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}