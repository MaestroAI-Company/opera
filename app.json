{
  "expo": {
    "name": "Opera",
    "slug": "opera",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icons/opera.png",
    "scheme": "opera",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/icons/opera.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF1A1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "ai.maestro.opera",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon_nobg.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF1A1A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "dark",
          "backgroundColor": "transparent"
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Opera needs access to your microphone for voice-to-text."
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Opera needs access to your photos to attach them.",
          "savePhotosPermission": "Opera needs access to save photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Opera needs access to your photos to attach them.",
          "cameraPermission": "Opera needs access to your camera to take photos."
        }
      ],
      "./plugins/withNotifeeRepo.js",
      "./plugins/withNativeAndroid"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}