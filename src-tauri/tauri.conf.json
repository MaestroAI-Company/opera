{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Opera",
  "version": "0.1.0",
  "identifier": "ai.maestro.opera",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npx expo export -p web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Opera",
        "width": 800,
        "height": 600,
        "backgroundColor": "#FEFBF6",
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/models/deki-yolo-fp16.onnx": "models/deki-yolo-fp16.onnx"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Maestro AI",
    "copyright": "© Maestro AI",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["opera"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCOTg0M0ZGN0Y0Mzc4REMKUldUY2VFTi8vME9ZYTIvRmZycXdkSHN2V1p3VnM3UkgrbEx4alBIRXZzbm9sZ2dTTGlhZWF6N2YK",
      "endpoints": ["https://github.com/MaestroAI-Company/opera/releases/latest/download/latest.json"]
    },
    "oauth": "<html><head><script>window.addEventListener('load',function(){setTimeout(function(){window.location.replace('opera://oauth2redirect')},500)})</script></head><body>Retour à Opera... <a href=\"opera://oauth2redirect\">Ouvrir Opera</a></body></html>"
  }
}
