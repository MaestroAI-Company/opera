# google drive OAuth on web only works if this exact URL is registered in
# Google Cloud Console > Credentials > OAuth client (web) > authorized redirect URIs.
# leave unset locally, only needed for a fixed prod/self-host domain.
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=https://chat.maestroai.company/oauth2redirect/google

# only needed if this deployment uses its own Google Cloud OAuth client
# instead of the default one baked into GoogleDriveProvider.ts
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# hosted ollama server offered as the "Opera Beta" provider.
# public value, not a secret. without it the beta option is hidden.
# EXPO_PUBLIC_BETA_SERVER_URL=
